# Copia este archivo a .env.local y rellénalo. En Vercel: Settings → Environment Variables.
# Los valores están en Supabase → Project Settings → API Keys / Data API.

# URL del proyecto: https://<id>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública ("publishable" o la antigua "anon"). Es segura en el navegador: la protegen las políticas de la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para scripts/migrate-blog.mjs, en local. Clave secreta ("secret" o la antigua "service_role").
# NO la añadas en Vercel ni la compartas: salta todas las políticas de seguridad.
SUPABASE_SECRET_KEY=

# Obligatoria en Vercel (Production): sin ella /api/cron/keep-alive responde 401 y el proyecto
# de Supabase se acaba pausando. Cualquier texto largo y aleatorio. Haz redeploy al añadirla.
CRON_SECRET=
